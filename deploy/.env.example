# Copy to deploy/.env (chmod 600). Empty values must be filled in, except the NEWAPI_* import; compose refuses to start otherwise.

# Both lines come from release.env, an artifact of the pipeline's registry_verify job.
PORTAL_IMAGE=
ADMIN_IMAGE=

# Address the CDN connects to, e.g. <public IP>:80
ENTRY_BIND=127.0.0.1:18090
# Must not overlap another network on the host.
EDGE_SUBNET=172.31.130.0/24

# openssl rand -hex 32 (goes into a URL, so no base64). Two different secrets for the sessions.
APP_DB_PASSWORD=
PORTAL_SESSION_SECRET=
ADMIN_SESSION_SECRET=
# openssl rand -hex 32. Encrypts TOTP secrets, the pools' connections and the submitted channel keys; store it apart from appdb backups.
# Lost: every TOTP stops working (backup codes and passkeys still do) and every pool must be entered again.
APP_MASTER_KEY=
# openssl rand -hex 24 (goes into a URL, so no base64). MongoDB, which keeps the logs synced from pools for 30 days.
MONGO_PASSWORD=

# The addresses users open, e.g. https://portal.example.com: scheme and host, no path. Passkeys are bound to them.
PORTAL_PUBLIC_ORIGIN=
ADMIN_PUBLIC_ORIGIN=

# new-api: see "new-api 侧准备" in README.md
# The docker network new-api runs on: docker network ls
NEWAPI_NETWORK=
# The pools live in the admin's settings page. The variables below are read only while appdb never held a pool,
# imported once as pool 1 (audit settings.newapi_import) and ignored after that: leave them empty on a new install,
# and delete them once an upgrade has imported them.
# e.g. http://<new-api container>:3000
NEWAPI_BASE_URL=
NEWAPI_PAT=
# Read-only role, e.g. postgres://newapi_ro:<password>@<postgres container>:5432/<db>?sslmode=disable
NEWAPI_DB_DSN=
# Only when new-api keeps its logs in a separate database (LOG_SQL_DSN).
NEWAPI_LOG_DB_DSN=
# Optional, may stay empty: a role of its own that reads only channels.id and key,
# for testing multi-key OpenRouter channels key by key and querying their balances
# (see README). Must differ from NEWAPI_DB_DSN. Empty turns that feature off.
NEWAPI_KEY_DB_DSN=
